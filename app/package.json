{
    "name":  "lawverify-mvp",
    "description":  "LawVerify desktop client for local evidence verification workbench",
    "productName":  "LawVerify",
    "author":  "Hexuanfang",
    "private":  true,
    "version":  "0.2.2",
    "type":  "module",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "vite",
                    "dev:api":  "npm --prefix ../server run dev",
                    "dev:web":  "vite",
                    "dev:stack":  "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
                    "dev:electron":  "wait-on http-get://127.0.0.1:5173 \u0026\u0026 electron electron/main.cjs",
                    "dev:desktop":  "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:electron\"",
                    "build:server":  "npm --prefix ../server run build",
                    "prepare:desktop":  "node electron/prepare-desktop.cjs",
                    "prepare:builder-cache":  "node electron/prepare-builder-cache.cjs",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "build:desktop":  "npm run build \u0026\u0026 npm run build:server \u0026\u0026 npm run prepare:desktop \u0026\u0026 npm run prepare:builder-cache \u0026\u0026 node electron/run-electron-builder.cjs --publish never --win nsis",
                    "build:desktop:signed":  "node electron/build-signed.cjs",
                    "build:mac":  "node electron/build-mac.cjs",
                    "build:mac:signed":  "node electron/build-mac.cjs --signed",
                    "export:law-cache":  "node electron/export-law-cache.cjs",
                    "verify:mac":  "node electron/verify-mac.cjs",
                    "build:desktop:dir":  "npm run build \u0026\u0026 npm run build:server \u0026\u0026 npm run prepare:desktop \u0026\u0026 npm run prepare:builder-cache \u0026\u0026 node electron/run-electron-builder.cjs --publish never --win dir",
                    "verify:signature":  "powershell -NoProfile -ExecutionPolicy Bypass -File electron/inspect-windows-signature.ps1 -RequireValid",
                    "verify:workspace":  "node electron/verify-workspace-sqlite.cjs",
                    "test:stability":  "node --test electron/test-service-supervisor.cjs \u0026\u0026 node electron/run-stability-tests.mjs",
                    "test:desktop-service":  "node electron/run-electron-test.cjs test-desktop-service.cjs",
                    "test:layout":  "node electron/run-electron-test.cjs test-redesign.cjs --layout-only",
                    "test:word-export": "node electron/run-electron-test.cjs test-redesign.cjs --export-only",
                    "test:cases":  "node electron/run-electron-test.cjs test-case-mutations.cjs",
                    "test:account":  "node --test electron/test-account-network.cjs \u0026\u0026 node electron/run-electron-test.cjs test-account-proxy.cjs",
                    "test:redesign": "node --experimental-strip-types --test src/redesign/model.test.ts src/redesign/caseFileKind.test.ts src/redesign/libraryRows.test.ts src/redesign/documentBilling.test.ts src/redesign/verificationProgress.test.ts src/redesign/reviewOverview.test.ts src/redesign/verificationMemory.test.ts src/redesign/caseResearchReport.test.ts src/redesign/assistantIntent.test.ts src/redesign/documentSelection.test.ts src/redesign/reviewHighlights.test.ts src/auth-transition.test.ts && node electron/run-electron-test.cjs test-redesign.cjs",
                    "lint":  "oxlint",
                    "preview":  "vite preview",
                    "desktop":  "electron electron/main.cjs"
                },
    "dependencies":  {
                         "@tailwindcss/vite": "^4.3.5",
                         "class-variance-authority": "^0.7.1",
                         "clsx": "^2.1.1",
                         "cn": "^0.5.2",
                         "lucide-react": "^1.73.0",
                         "radix-ui": "^1.8.1",
                         "tailwind-merge": "^3.7.0",
                         "tailwindcss": "^4.3.5",
                         "bcryptjs":  "^3.0.3",
                         "compression":  "^1.8.2",
                         "cors":  "^2.8.5",
                         "docx":  "^9.7.1",
                         "dotenv":  "^18.0.1",
                         "express":  "^5.1.0",
                         "helmet":  "^8.3.0",
                         "http-proxy":  "^1.18.1",
                         "jsonwebtoken":  "^9.0.3",
                         "mammoth":  "^1.12.3",
                         "multer":  "^2.4.0",
                         "pdf-parse":  "^2.4.5",
                         "pg":  "^8.23.0",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.13.3",
                            "@types/qrcode":  "^1.5.6",
                            "superdoc":  "2.34.0",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.7",
                            "@vitejs/plugin-react":  "^6.1.1",
                            "concurrently":  "^10.0.5",
                            "docx-preview":  "^0.4.0",
                            "electron":  "^44.4.2",
                            "electron-builder":  "^26.0.12",
                            "html-to-image":  "^1.11.13",
                            "oxlint":  "^1.81.0",
                            "pdfjs-dist":  "^5.4.296",
                            "qrcode":  "^1.5.4",
                            "react":  "^19.2.8",
                            "react-dom":  "^19.2.8",
                            "typescript":  "~6.0.2",
                            "vite":  "^8.3.0",
                            "wait-on":  "^9.1.0"
                        },
    "build":  {
                  "appId":  "com.zhijing.lawverify",
                  "productName":  "LawVerify",
                  "compression":  "maximum",
                  "electronDist":  "node_modules/electron/dist",
                  "electronLanguages":  [
                                            "zh-CN",
                                            "en-US"
                                        ],
                  "directories":  {
                                      "output":  "release"
                                  },
                  "extraResources": [
                                { "from": ".desktop/parser", "to": "parser" }
                            ],
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                ".desktop/server/.env.local",
                                ".desktop/server/**/*",
                                "!electron/parser-resources.cjs",
                                "package.json"
                            ],
                  "win":  {
                              "files": [
                                  "dist/**/*", "electron/**/*", ".desktop/server/.env.local", ".desktop/server/**/*", "package.json",
                                  "!electron/test-*", "!electron/redesign-*-checks.cjs",
                                  "!electron/run-*", "!electron/*builder*.cjs", "!electron/build-*",
                                  "!electron/prepare-*", "!electron/verify-*", "!electron/export-*",
                                  "!electron/parser-resources.cjs", "!electron/*.ps1",
                                  "!node_modules/{@tailwindcss,@radix-ui,radix-ui,lucide-react,tailwindcss,tailwind-merge,lightningcss,lightningcss-*,jiti,clsx,cn,class-variance-authority}/**/*",
                                  "!node_modules/{pdf-parse,pdfjs-dist,@napi-rs/canvas,@napi-rs/canvas-*}/**/*"
                              ],
                              "icon":  "build/icon.ico",
                              "signExecutable":  false,
                              "signtoolOptions":  {
                                                      "signingHashAlgorithms":  [
                                                                                    "sha256"
                                                                                ],
                                                      "rfc3161TimeStampServer":  "http://timestamp.digicert.com",
                                                      "timeStampServer":  "http://timestamp.digicert.com"
                                                  },
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "artifactName":  "LawVerify-Setup-${version}.${ext}"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "include":  "build/installer.nsh",
                               "createDesktopShortcut":  true,
                               "shortcutName":  "LawVerify"
                           }
              }
}
