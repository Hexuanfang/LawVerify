CLOUD_PORT=8788
CLOUD_HOST=0.0.0.0
CLOUD_APP_NAME=LawVerify Cloud
CLOUD_WEB_ORIGIN=http://127.0.0.1:4273,http://localhost:4273,https://lawagent.zhijing.fun
CLOUD_PUBLIC_BASE_URL=https://lawagent.zhijing.fun
# Enable only after uploading installers and verifying the real HTTPS download domain.
# RELEASE_DOWNLOAD_BASE_URL=https://downloads.example.com/lawverify
JSON_LIMIT=2mb

# Assistant model catalog and OpenAI-compatible speech transcription.
# Production must enable the AI gateway: every desktop AI feature (evidence linking,
# case auto-analysis, ...) is served by /api/ai/*. While the gateway is disabled the
# platform answers 503 "AI service is preparing" and no AI feature works.
# This file is intentionally NOT uploaded by scripts/deploy-platform-release.ps1:
# create it once on the server (or inject the same variables through a systemd
# EnvironmentFile) and keep the provider key out of the repository.
# AI_GATEWAY_ENABLED=true
# LLM_BASE_URL=https://provider.example.com/v1
# LLM_API_KEY=replace-with-provider-key
# LLM_MODEL=default-chat-model
# LLM_CHAT_MODELS=another-approved-chat-model
# Default text requests can use the configured vision provider on transient failure.
LLM_TEXT_FALLBACK_ENABLED=true
# LLM_TIMEOUT_MS=120000
# EMBEDDING_BASE_URL=https://provider.example.com/v1
# EMBEDDING_API_KEY=replace-with-provider-key
# EMBEDDING_MODEL=default-embedding-model
# EMBEDDING_DIMENSION=1024
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=replace-with-speech-provider-key
# ASR_MODEL=whisper-1

# PostgreSQL
DATABASE_URL=
AUTO_RUN_MIGRATIONS=false
MIGRATIONS_DIR=
DEV_PAYMENT_SIMULATION=false
# Enable rewards only after confirming campaign cost and rules.
REFERRAL_REWARDS_ENABLED=false
REFERRAL_INVITER_POINTS=100
REFERRAL_INVITEE_POINTS=50
REFERRAL_MIN_PAYMENT_FEN=1000
JWT_SECRET=lawverify-cloud-dev-secret
JWT_EXPIRES_IN=12h

# Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=

# WeChat Pay
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
