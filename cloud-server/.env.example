# ---- 云端 API 与对外访问 ----
CLOUD_PORT=8788
CLOUD_HOST=0.0.0.0
CLOUD_APP_NAME=LawVerify Cloud
JSON_LIMIT=2mb
# 两个官网域名指向同一套服务，都要允许跨域调用云端接口。
CLOUD_WEB_ORIGIN=http://127.0.0.1:4273,http://localhost:4273,https://lawverify.zhijing.fun,https://lawagent.zhijing.fun
# 官网对外链接（下载、注册邀请、支付回跳）的统一域名。
CLOUD_PUBLIC_BASE_URL=https://lawverify.zhijing.fun
# 上传安装包并验证 HTTPS 下载域名后再配置。
# RELEASE_DOWNLOAD_BASE_URL=https://downloads.example.com/lawverify

# ---- 平台管理员 ----
# 平台管理员标识（逗号分隔）：这些标识可作为注册邮箱，并拥有 /api/admin/* 后台权限。
ADMIN_EMAILS=admin,972167580@qq.com

# ---- AI 网关与文本模型 ----
# 生产环境需启用网关。桌面端 AI 功能由 /api/ai/* 提供，网关关闭时返回 503。
# 供应商凭据仅存放在服务端 .env.local，或通过 systemd EnvironmentFile 注入。
# AI_GATEWAY_ENABLED=true
# LLM_BASE_URL=https://provider.example.com/v1
# LLM_API_KEY=replace-with-provider-key
# LLM_MODEL=default-chat-model
# LLM_CHAT_MODELS=another-approved-chat-model
# 文本请求遇到临时故障时，可回退到已配置的视觉模型。
LLM_TEXT_FALLBACK_ENABLED=true
# LLM_TIMEOUT_MS=120000

# ---- 视觉模型 ----
# 按需配置视觉服务地址、密钥和模型。
# LLM_VISION_BASE_URL=https://provider.example.com/v1
# LLM_VISION_API_KEY=
# LLM_VISION_MODEL=

# ---- 向量模型 ----
# EMBEDDING_BASE_URL=https://provider.example.com/v1
# EMBEDDING_API_KEY=replace-with-provider-key
# EMBEDDING_MODEL=default-embedding-model
# EMBEDDING_DIMENSION=1024

# ---- 语音转写 ----
# 使用 OpenAI 兼容接口，按需填写服务地址、密钥和模型。
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=replace-with-speech-provider-key
# ASR_MODEL=whisper-1

# ---- 法律案例检索（MCP）----
# 元典使用默认服务地址，北大法宝的服务地址由其开发者控制台提供。
# YUANDIAN_MCP_URL=https://open.chineselaw.com/mcp
# YUANDIAN_API_KEY=
# PKULAW_MCP_URL=
# PKULAW_API_KEY=

# ---- 云端解析 ----
# 云端解析凭证签名密钥，使用 Ed25519 PKCS#8 DER 的 Base64 编码。
# PARSER_TICKET_PRIVATE_KEY=

# ---- PostgreSQL 与迁移 ----
DATABASE_URL=
AUTO_RUN_MIGRATIONS=false
MIGRATIONS_DIR=

# ---- 会话鉴权 ----
JWT_SECRET=lawverify-cloud-dev-secret
JWT_EXPIRES_IN=12h

# ---- 手机号认证 ----
# 手机号认证需要 PostgreSQL、已审核的签名与验证码模板（模板变量为 code）。
# 使用阿里云默认凭据链，AccessKey 或临时凭据由服务运行环境注入。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 独立的随机密钥，至少 32 字符。
SMS_OTP_SECRET=
# 反代部署时可配置逗号分隔的可信代理 CIDR。
SMS_TRUST_PROXY_CIDRS=

# ---- 邀请奖励 ----
# 确认活动成本与规则后再开启，最低支付金额单位为分。
REFERRAL_REWARDS_ENABLED=false
REFERRAL_INVITER_POINTS=100
REFERRAL_INVITEE_POINTS=50
REFERRAL_MIN_PAYMENT_FEN=1000

# ---- 支付与回调 ----
# 模拟支付用于本地开发。
DEV_PAYMENT_SIMULATION=false

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=

# 微信支付
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
