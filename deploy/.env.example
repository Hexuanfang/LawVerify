# 复制为 deploy/.env 后填写。该文件只放在服务器上，不要提交。
# 注意：可选的 URL 类变量不用时请整行注释，不要写成空值（例如 ASR_BASE_URL=），否则启动校验失败。

# ---- 对外访问 ----
WEB_BIND=0.0.0.0
WEB_PORT=8090
# 用户实际访问的地址（无域名时用 http://IP:端口）
CLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8090
CLOUD_WEB_ORIGIN=http://127.0.0.1:8090

# ---- 构建 ----
# 国内服务器建议使用镜像源
NPM_REGISTRY=https://registry.npmmirror.com
IMAGE_TAG=latest

# ---- 数据库与鉴权（必填，用 openssl rand -hex 24 / 48 生成）----
# 只用字母数字，避免拼接 DATABASE_URL 时需要转义
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- 系统管理员 ----
# 拥有 /admin 权限的账号列表（逗号分隔）
ADMIN_EMAILS=admin
# 首次启动时若该账号不存在则自动创建；留空则不创建，改用命令：
#   ./admin.sh create admin
ADMIN_INITIAL_EMAIL=admin
ADMIN_INITIAL_PASSWORD=

# ---- 安装包下载 ----
# 安装包放在 deploy/releases/（文件名如 LawVerify-Setup-0.1.59.exe）
RELEASE_DIR=./releases
# RELEASE_DOWNLOAD_BASE_URL=https://downloads.example.com/lawverify

# ---- 业务开关 ----
DEV_PAYMENT_SIMULATION=false
REFERRAL_REWARDS_ENABLED=false

# ---- AI 网关（可选）----
# AI_GATEWAY_ENABLED=true
# LLM_BASE_URL=https://provider.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_CHAT_MODELS=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=
# ASR_MODEL=whisper-1

# ---- 支付（可选，回调地址需 HTTPS）----
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PLATFORM_SERIAL_NO=
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=

# ---- 官网前端（构建时写入，修改后需重新构建 web 镜像）----
VITE_SITE_URL=
VITE_COMPANY_NAME=
VITE_BAIDU_TONGJI_ID=
VITE_ICP_NUMBER=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
