# LawVerify 服务 https://lv.zhijing.fun
# 证书：Let's Encrypt，certbot 证书名 lv-zhijing，webroot /var/www/acme
server {
  listen 80;
  server_name lv.zhijing.fun;
  location /.well-known/acme-challenge/ {
    root /var/www/acme;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name lv.zhijing.fun;

  ssl_certificate     /etc/letsencrypt/live/lv-zhijing/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/lv-zhijing/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # 仅在仍运行旧版云端解析服务时保留此段。
  location = /parse {
    proxy_pass http://127.0.0.1:8790;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 512m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 10s;
    proxy_send_timeout 960s;
    proxy_read_timeout 960s;
    proxy_next_upstream off;
    access_log off;
  }

  # LawVerify 主服务
  location / {
    proxy_pass http://127.0.0.1:8788;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 30m;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }
}
