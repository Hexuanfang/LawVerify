# 复制为部署目标的 python-workers/.env。
# 云端解析使用 cloud-server 签发的票据。共享 Token 用于回环测试。
PARSER_SERVICE_TOKEN=
# Ed25519 SPKI DER 公钥的 Base64 编码。
PARSER_TICKET_PUBLIC_KEY=
PARSER_MODELS_DIR=../python-workers/mineru-home
PARSER_PORT=8790
SERVICE_BIND=127.0.0.1
PARSER_WORKERS=1
PARSER_CPUS=8
PARSER_MAX_ACCOUNT_PENDING=2
PARSER_MAX_ACCOUNT_IN_FLIGHT_MB=512
PARSER_MAX_IN_FLIGHT_MB=1024
PARSER_TIMEOUT_MS=900000
PARSER_MEMORY_LIMIT=5g
