# ---- 本地 API 与服务地址 ----
NODE_ENV=development
PORT=8787
# 默认只监听回环地址。局域网调试时改为 0.0.0.0。
SERVER_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
JSON_LIMIT=20mb
API_PREFIX=/api
API_V1_PREFIX=/api/v1
CLOUD_API_BASE_URL=http://127.0.0.1:8788

# ---- 数据库、迁移与鉴权 ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lawverify
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=12h
AUTO_RUN_MIGRATIONS=false

# ---- 文件存储 ----
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_BASE_URL=/uploads

# ---- 文本模型 ----
# 供应商类型支持 deepseek 或 openai-compatible。请求超时单位为毫秒。
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
# 同一服务地址和密钥下可选的其他聊天模型，以逗号分隔。
# LLM_CHAT_MODELS=qwen-plus,qwen-max

# ---- 语音转写 ----
# 使用独立配置的 OpenAI 兼容接口，启用时填写服务地址、密钥和模型。
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=replace-with-speech-provider-key
# ASR_MODEL=whisper-1

# ---- 视觉模型 ----
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=qwen3.8-flash

# ---- 知识库检索、向量模型与 Qdrant ----
# 检索模式支持 local、commercial 和 auto。
KNOWLEDGE_RAG_MODE=local
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=60000
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_KNOWLEDGE=knowledge_chunks
QDRANT_TIMEOUT_MS=60000

# ---- 法律案例检索（MCP）----
# 按需填写元典、威科先行或北大法宝的接入参数。
YUANDIAN_MCP_URL=https://open.chineselaw.com/mcp
YUANDIAN_API_KEY=
YUANDIAN_CASE_SEARCH_TOOL=
WK_MCP_URL=https://mcp.wkinfo.com.cn/mcp-servers/integrated/
WK_API_KEY=
WK_CASE_SEARCH_TOOL=
PKULAW_MCP_URL=
PKULAW_API_KEY=
PKULAW_CASE_SEARCH_TOOL=

# ---- 本机文档解析 ----
# 开发时可覆盖项目内默认的 tmp/parser-runtime 和 python-workers/mineru-home。
# LAWVERIFY_PYTHON=
# LAWVERIFY_MINERU_HOME=
# 本机解析按资源自动调度。可降低并发上限，或设为仅使用 CPU。
PARSER_WORKERS=2
PARSER_DEVICE=auto
PARSER_TIMEOUT_MS=900000

# ---- 解析服务联调 ----
# HTTP 解析联调脚本使用的服务地址及共享 Token。
# PARSER_SERVICE_URL=http://127.0.0.1:8790
# PARSER_SERVICE_TOKEN=

# ---- 调试 ----
# 调试埋点上报地址，留空则不发送任何调试请求。
DEBUG_EVENT_URL=
