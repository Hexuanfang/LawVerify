NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173
JSON_LIMIT=20mb
APP_NAME=lawverify-server
API_PREFIX=/api
API_V1_PREFIX=/api/v1
KNOWLEDGE_RAG_MODE=local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lawverify
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=12h
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_BASE_URL=/uploads
AUTO_RUN_MIGRATIONS=false
APP_PUBLIC_BASE_URL=http://localhost:8787
CLOUD_API_BASE_URL=http://127.0.0.1:8788
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Additional approved chat models using the same provider URL and key.
# LLM_CHAT_MODELS=qwen-plus,qwen-max
# OpenAI-compatible transcription endpoint, configured separately from chat.
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=replace-with-speech-provider-key
# ASR_MODEL=whisper-1
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=qwen3.8-flash
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=60000
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_KNOWLEDGE=knowledge_chunks
QDRANT_TIMEOUT_MS=60000
YUANDIAN_MCP_URL=https://open.chineselaw.com/mcp
YUANDIAN_API_KEY=
YUANDIAN_CASE_SEARCH_TOOL=
WK_MCP_URL=https://mcp.wkinfo.com.cn/mcp-servers/integrated/
WK_API_KEY=
WK_CASE_SEARCH_TOOL=
PKULAW_MCP_URL=
PKULAW_API_KEY=
PKULAW_CASE_SEARCH_TOOL=
COLLABORA_PUBLIC_URL=
COLLABORA_WOPI_ALLOW_EDIT=true
