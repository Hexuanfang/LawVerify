{
  "name": "lawverify-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "sync:legal-sources": "tsx src/scripts/sync-legal-sources.ts",
    "build": "tsc -p tsconfig.json",
    "test:linkage": "node --import tsx --test scripts/test-semantic-linkage.mjs",
    "test:workspace": "node --import tsx --test scripts/test-workspace-sqlite.mjs",
    "start": "node dist/index.js",
    "start:collabora-proxy": "node dist/collabora-proxy.js"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^18.0.1",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
