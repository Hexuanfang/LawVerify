# ---- 云端 API ----
# 官网调用的云端 API 地址。
VITE_CLOUD_API_BASE=https://lawverify.zhijing.fun

# ---- 站点与页脚 ----
# 留空时使用程序内置默认值。
# 官网域名，用于 canonical、分享链接和“复制下载页链接”
VITE_SITE_URL=https://lawverify.zhijing.fun
# 公司正式全称（页脚显示）
VITE_COMPANY_NAME=北京智镜科技
# ICP 备案号
VITE_ICP_NUMBER=京ICP备2026073156号-1

# ---- 用户协议与隐私政策 ----
# 正式页面上线后填写地址，留空时隐藏对应链接。
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# ---- 访问统计 ----
# 百度统计 ID（hm.js?后面的标识），留空时跳过统计脚本加载。
VITE_BAIDU_TONGJI_ID=
